#extension GL_GOOGLE_include_directive: require
#extension GL_EXT_shader_16bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require
#extension GL_EXT_control_flow_attributes: require
#extension GL_KHR_cooperative_matrix: enable
#extension GL_KHR_memory_scope_semantics: enable

#include "interface/rp_oidn.h"

layout (local_size_x = WG_SIZE_X, local_size_y = WG_SIZE_Y) in;

layout(binding = BINDING_INDEX_UNIFORM_DATA, std140) uniform UniformDataUbo { UniformData ubo; };
layout(binding = BINDING_INDEX_INPUT_BUF1, std430) readonly buffer InputBuffer { float16_t inPixels[]; };
#ifdef OUT_CHANNEL_F32
layout(binding = BINDING_INDEX_OUTPUT_BUF, std430) writeonly buffer OutputBuffer { float outPixels[]; };
#else
layout(binding = BINDING_INDEX_OUTPUT_BUF, std430) writeonly buffer OutputBuffer { float16_t outPixels[]; };
#endif
layout(binding = BINDING_INDEX_TENSOR_BUF, std430) readonly buffer TensorBuffer { float16_t tensors[]; };
#ifdef OP_CONCAT
layout(binding = BINDING_INDEX_INPUT_BUF2, std430) readonly buffer InputBuffer2 { float16_t inPixels2[]; };
#endif
// TODO: in hindsight, it would be much nicer to rename this to MaxLuminanceBuffer & maxLuminance
#if defined(SCALE_INPUT_INV) || defined(SCALE_INPUT2_INV) || defined(SCALE_OUTPUT)
layout(binding = BINDING_INDEX_VALUE_SCALE_BUF, std430) readonly buffer ValueScaleBuffer { float valueScale; };
#endif

#define KERNEL_SIZE 3
#define KERNEL_SIZE_SQ (KERNEL_SIZE * KERNEL_SIZE)
#define KERNEL_BIAS (KERNEL_SIZE / 2)

// Each invocation computes a block of OUT_ROWS_PER_THREAD x OUT_COLS_PER_THREAD
// output pixels to amortize the uniform weight loads. A whole pooling block is
// computed and pooled by a single invocation. Must match the dispatch size
// computation in Oidn.cpp!
#define OUT_ROWS_PER_THREAD 2
#ifdef OP_MAX_POOL
#define OUT_COLS_PER_THREAD 2
#else
#define OUT_COLS_PER_THREAD 1
#endif

#define TILE_SIZE_X (WG_SIZE_X * OUT_COLS_PER_THREAD)
#define TILE_SIZE_Y (WG_SIZE_Y * OUT_ROWS_PER_THREAD)
#define LOAD_PASSES_X ((TILE_SIZE_X + 2 + WG_SIZE_X - 1) / WG_SIZE_X)
#define LOAD_PASSES_Y ((TILE_SIZE_Y + 2 + WG_SIZE_Y - 1) / WG_SIZE_Y)

// Vector of convolution results for the invocation's output block.
#if OUT_COLS_PER_THREAD == 2
#define BLOCK_VECTOR f16vec4
#define BLOCK_TAPS(j, i) f16vec4(win[j][i], win[j][i + 1], win[j + 1][i], win[j + 1][i + 1])
#else
#define BLOCK_VECTOR f16vec2
#define BLOCK_TAPS(j, i) f16vec2(win[j][i], win[j + 1][i])
#endif

// Cooperative matrix tile sizes (rows x columns x reduction). The host must set
// these to a combination the device supports for f16 operands and accumulators
// (VkPhysicalDeviceCooperativeMatrixPropertiesKHR), and CM_SUBGROUP_SIZE to the
// device's subgroup size (VkPhysicalDeviceSubgroupProperties).
#ifndef CM_M
#define CM_M 16
#endif
#ifndef CM_N
#define CM_N 16
#endif
#ifndef CM_K
#define CM_K 16
#endif
#ifndef CM_SUBGROUP_SIZE
#define CM_SUBGROUP_SIZE 32
#endif

#if CONV_IMPL == CONV_IMPL_COOP_MATRIX
#if WG_SIZE_X % CM_SUBGROUP_SIZE != 0
#error The workgroup size in X must be a multiple of CM_SUBGROUP_SIZE.
#endif

#define CM_TYPE_A coopmat<float16_t, gl_ScopeSubgroup, CM_M, CM_K, gl_MatrixUseA>
#define CM_TYPE_B coopmat<float16_t, gl_ScopeSubgroup, CM_K, CM_N, gl_MatrixUseB>
#define CM_TYPE_C coopmat<float16_t, gl_ScopeSubgroup, CM_M, CM_N, gl_MatrixUseAccumulator>

// Output tiles are CM_N pixels wide; the pixel columns of the last tile of a
// row may overhang the workgroup tile, which the result readback ignores.
#define CM_TILES_PER_ROW ((TILE_SIZE_X + CM_N - 1) / CM_N)
#define CM_RESULT_SIZE_X (CM_TILES_PER_ROW * CM_N)
#define CM_RESULT_CHANNEL_COUNT (((CONV_CHANNEL_COUNT + CM_M - 1) / CM_M) * CM_M)
#define CM_CHANNEL_TILES ((CONV_CHANNEL_COUNT + CM_M - 1) / CM_M)
#define CM_WINDOW_ROW_SIZE (CM_RESULT_SIZE_X + 2)
#define CM_PIXEL_TILES (TILE_SIZE_Y * CM_TILES_PER_ROW)
#define CM_SUBGROUP_COUNT ((WG_SIZE_X * WG_SIZE_Y) / CM_SUBGROUP_SIZE)
#define CM_PIXEL_TILES_PER_WARP ((CM_PIXEL_TILES + CM_SUBGROUP_COUNT - 1) / CM_SUBGROUP_COUNT)
#else
#define CM_RESULT_SIZE_X TILE_SIZE_X
#define CM_RESULT_CHANNEL_COUNT CONV_CHANNEL_COUNT
#endif

#if CONV_IMPL == CONV_IMPL_SHMEM
shared float16_t sh_window[TILE_SIZE_Y + 2][TILE_SIZE_X + 2];
#elif CONV_IMPL == CONV_IMPL_COOP_MATRIX
// [(TILE_SIZE_Y + 2) rows][CM_WINDOW_ROW_SIZE pixels][CM_K channels], flat so it
// can be handed to coopMatLoad. CM_K and CM_RESULT_CHANNEL_COUNT are multiples
// of 8 elements, which keeps the matrix offsets and strides 16 byte aligned as
// required by the extension.
shared float16_t sh_window[(TILE_SIZE_Y + 2) * CM_WINDOW_ROW_SIZE * CM_K];
// Double buffered staging for the weight tiles.
shared float16_t sh_weights[2 * CM_RESULT_CHANNEL_COUNT * CM_K];
#endif

#if CONV_IMPL == CONV_IMPL_COOP_MATRIX
// Flat with the output channels innermost and the pixel columns padded to a
// multiple of CM_N, so cooperative matrix tiles can be stored directly. Pooled
// layers read the results back, too, as the pre-pooling distribution across a
// subgroup is implementation defined.
shared float16_t sh_results[TILE_SIZE_Y * CM_RESULT_SIZE_X * CM_RESULT_CHANNEL_COUNT];
#define RESULT_AT(y, x, oc) sh_results[((y) * CM_RESULT_SIZE_X + (x)) * CM_RESULT_CHANNEL_COUNT + (oc)]
#elif !defined(OP_MAX_POOL)
shared float16_t sh_results[TILE_SIZE_Y][TILE_SIZE_X][CONV_CHANNEL_COUNT];
#define RESULT_AT(y, x, oc) sh_results[(y)][(x)][(oc)]
#endif

void main()
{
#if defined(SCALE_INPUT_INV) || defined(SCALE_INPUT2_INV)
  // A black frame yields a maximum luminance of 0; fall back to 1 as the reference
  // does, and keep the reciprocal within half-float range.
  float16_t invValueScale = float16_t((valueScale > 0.0) ? min(1.0 / valueScale, 65504.0) : 1.0);
#endif

#if CONV_IMPL == CONV_IMPL_SEQ

#ifdef OP_MAX_POOL

  // A whole pooling block is computed and pooled by a single invocation.
  if (gl_GlobalInvocationID.x >= ubo.imageWidth / 2 ||
      gl_GlobalInvocationID.y >= ubo.imageHeight / 2)
  {
    return;
  }

  ivec2 blockOrigin = ivec2(gl_GlobalInvocationID.x * OUT_COLS_PER_THREAD,
                            gl_GlobalInvocationID.y * OUT_ROWS_PER_THREAD);

  for (uint oc = 0; oc < CONV_CHANNEL_COUNT; oc++)
  {
    float16_t results[OUT_ROWS_PER_THREAD * OUT_COLS_PER_THREAD];

    [[unroll]]
    for (uint p = 0; p < OUT_ROWS_PER_THREAD * OUT_COLS_PER_THREAD; p++)
    {
      results[p] = float16_t(0.0);

      ivec2 pixel = blockOrigin + ivec2(int(p) % OUT_COLS_PER_THREAD, int(p) / OUT_COLS_PER_THREAD);

      for (uint i = 0; i < KERNEL_SIZE; i++)
      for (uint j = 0; j < KERNEL_SIZE; j++)
      {
        ivec2 coord = pixel + ivec2(i, j) - ivec2(KERNEL_BIAS);

        if (any(lessThan(coord, ivec2(0))) ||
            any(greaterThanEqual(uvec2(coord), uvec2(ubo.imageWidth, ubo.imageHeight))))
        {
          continue; // oob
        }

        int coordIdx = int(coord.y * ubo.imageWidth + coord.x);

        for (uint ic = 0; ic < IN1_CHANNEL_COUNT; ic++)
        {
          uint inIndexIj = coordIdx * IN1_CHANNEL_COUNT + ic;

          uint weightIndex = (oc * IN1_CHANNEL_COUNT * KERNEL_SIZE_SQ) + (ic * KERNEL_SIZE_SQ) + (j * KERNEL_SIZE + i); // OIHW

          float16_t weight = tensors[ubo.weightOffset + weightIndex];

          results[p] += inPixels[inIndexIj] * weight;
        }
      }
    }

    float16_t result = max(max(results[0], results[1]), max(results[2], results[3]));

#ifdef SCALE_INPUT_INV
    result *= invValueScale;
#endif

    result += tensors[ubo.biasOffset + oc];

    result = max(result, float16_t(0.0)); // ReLU activation

    int inIdx = int(gl_GlobalInvocationID.y * (ubo.imageWidth / 2) + gl_GlobalInvocationID.x);
    outPixels[inIdx * OUT_CHANNEL_COUNT + oc] = result;
  }

#else

  // naive
  for (uint oc = 0; oc < CONV_CHANNEL_COUNT; oc++)
  {
    [[unroll]]
    for (uint r = 0; r < OUT_ROWS_PER_THREAD; r++)
    {
      float16_t result = float16_t(0.0);

      for (uint i = 0; i < KERNEL_SIZE; i++)
      for (uint j = 0; j < KERNEL_SIZE; j++)
      {
        ivec2 coord = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y * OUT_ROWS_PER_THREAD + r)
                    + ivec2(i, j) - ivec2(KERNEL_BIAS);

        if (any(lessThan(coord, ivec2(0))) ||
            any(greaterThanEqual(uvec2(coord), uvec2(ubo.imageWidth, ubo.imageHeight))))
        {
          continue; // oob
        }

        int coordIdx = int(coord.y * ubo.imageWidth + coord.x);

        for (uint ic = 0; ic < IN1_CHANNEL_COUNT; ic++)
        {
          uint inIndexIj = coordIdx * IN1_CHANNEL_COUNT + ic;

          uint weightIndex = (oc * IN1_CHANNEL_COUNT * KERNEL_SIZE_SQ) + (ic * KERNEL_SIZE_SQ) + (j * KERNEL_SIZE + i); // OIHW

          float16_t weight = tensors[ubo.weightOffset + weightIndex];

          result += inPixels[inIndexIj] * weight;
        }
      }

      // Scale once after the accumulation instead of for every tap.
#ifdef SCALE_INPUT_INV
      result *= invValueScale;
#endif

      RESULT_AT(gl_LocalInvocationID.y * OUT_ROWS_PER_THREAD + r, gl_LocalInvocationID.x, oc) = result;
    }

    // No barrier is needed: the shared results are only read back by the
    // invocation that wrote them.
  }

#endif

#elif CONV_IMPL == CONV_IMPL_SHMEM

  // shared mem v1
  ivec2 wgBase = ivec2(gl_WorkGroupID.xy) * ivec2(TILE_SIZE_X, TILE_SIZE_Y);

#ifndef OP_MAX_POOL
  for (uint r = 0; r < OUT_ROWS_PER_THREAD; r++)
  for (uint oc = 0; oc < CONV_CHANNEL_COUNT; oc++)
    RESULT_AT(gl_LocalInvocationID.y * OUT_ROWS_PER_THREAD + r, gl_LocalInvocationID.x, oc) = float16_t(0.0);
#else
  // Accumulate the convolution results of the pooling block across input
  // channels in registers, then reduce them once.
  BLOCK_VECTOR accs[CONV_CHANNEL_COUNT];

  [[unroll]]
  for (uint oc = 0; oc < CONV_CHANNEL_COUNT; oc++)
    accs[oc] = BLOCK_VECTOR(0.0);
#endif

  [[unroll]]
  for (uint ic = 0; ic < IN1_CHANNEL_COUNT; ic++)
  {
    [[unroll]] for (int y = 0; y < int(LOAD_PASSES_Y); y++)
    [[unroll]] for (int x = 0; x < int(LOAD_PASSES_X); x++)
    {
      int lx = int(gl_LocalInvocationID.x) + x * int(WG_SIZE_X);
      int ly = int(gl_LocalInvocationID.y) + y * int(WG_SIZE_Y);

      if (lx < int(TILE_SIZE_X + 2) && ly < int(TILE_SIZE_Y + 2))
      {
        ivec2 coord = wgBase + ivec2(lx - 1, ly - 1);

        uint inPixelIdx = uint(coord.y * ubo.imageWidth + coord.x) * IN1_CHANNEL_COUNT + ic;

        bool oob = any(lessThan(coord, ivec2(0))) ||
                   any(greaterThanEqual(uvec2(coord), uvec2(ubo.imageWidth, ubo.imageHeight)));

        float16_t inValue = oob ? float16_t(0.0) : inPixels[inPixelIdx];

#ifdef SCALE_INPUT_INV
        inValue *= invValueScale;
#endif

        sh_window[ly][lx] = inValue;
      }
    }

    barrier();

    // Cache the window in registers so that it is not re-read from shared memory
    // for every output channel below.
    float16_t win[KERNEL_SIZE + OUT_ROWS_PER_THREAD - 1][KERNEL_SIZE + OUT_COLS_PER_THREAD - 1];
    [[unroll]] for (uint j = 0; j < KERNEL_SIZE + OUT_ROWS_PER_THREAD - 1; j++)
    [[unroll]] for (uint i = 0; i < KERNEL_SIZE + OUT_COLS_PER_THREAD - 1; i++)
    {
      win[j][i] = sh_window[gl_LocalInvocationID.y * OUT_ROWS_PER_THREAD + j][gl_LocalInvocationID.x * OUT_COLS_PER_THREAD + i];
    }

    [[unroll]]
    for (uint oc = 0; oc < CONV_CHANNEL_COUNT; oc++)
    {
      uint weightIndexOffset = (oc * IN1_CHANNEL_COUNT * KERNEL_SIZE_SQ) + (ic * KERNEL_SIZE_SQ); // OIHW

      BLOCK_VECTOR result = BLOCK_VECTOR(0.0);

      [[unroll]] for (uint j = 0; j < KERNEL_SIZE; j++)
      [[unroll]] for (uint i = 0; i < KERNEL_SIZE; i++)
      {
        uint weightIndex = weightIndexOffset + (j * KERNEL_SIZE + i);
        float16_t weight = tensors[ubo.weightOffset + weightIndex];

        result += BLOCK_TAPS(j, i) * weight;
      }

#ifdef OP_MAX_POOL
      accs[oc] += result;
#else
      RESULT_AT(gl_LocalInvocationID.y * OUT_ROWS_PER_THREAD + 0, gl_LocalInvocationID.x, oc) += result.x;
      RESULT_AT(gl_LocalInvocationID.y * OUT_ROWS_PER_THREAD + 1, gl_LocalInvocationID.x, oc) += result.y;
#endif
    }

    // Barrier for the window WAR hazard across iterations.
    barrier();
  }

#ifdef OP_MAX_POOL
  if (gl_GlobalInvocationID.x < ubo.imageWidth / 2 &&
      gl_GlobalInvocationID.y < ubo.imageHeight / 2)
  {
    int inIdx = int(gl_GlobalInvocationID.y * (ubo.imageWidth / 2) + gl_GlobalInvocationID.x);

    for (uint oc = 0; oc < CONV_CHANNEL_COUNT; oc++)
    {
      float16_t result = max(max(accs[oc].x, accs[oc].y), max(accs[oc].z, accs[oc].w));

      result += tensors[ubo.biasOffset + oc];

      result = max(result, float16_t(0.0)); // ReLU activation

      outPixels[inIdx * OUT_CHANNEL_COUNT + oc] = result;
    }
  }
#endif

#elif CONV_IMPL == CONV_IMPL_COOP_MATRIX

  // Cooperative matrix convolution. Each subgroup computes CM_M output channels
  // for CM_N consecutive pixels per multiply-add, accumulating over the kernel
  // taps and the input channel chunks:
  //    out[oc][pix] = sum over ic, tap of weight[oc][ic][tap] * window[ic][pix + tap]
  // The weight operand (A) is restaged per (channel chunk, tap); the input
  // operand (B) is loaded directly from the window, whose channel index is
  // contiguous and serves as the reduction (row) dimension of the matrix.
  //
  // NOTE: the accumulators live across the chunk loop, so the register budget
  // is CM_CHANNEL_TILES * CM_PIXEL_TILES_PER_WARP matrices; large output channel
  // counts or workgroup tiles may require picking a smaller workgroup size.
  // The shared memory used by a workgroup is
  //   (TILE_SIZE_Y + 2) * CM_WINDOW_ROW_SIZE * CM_K window elements
  // + TILE_SIZE_Y * CM_RESULT_SIZE_X * CM_RESULT_CHANNEL_COUNT result elements
  // + 2 * CM_RESULT_CHANNEL_COUNT * CM_K weight elements
  // and must be taken into account when the host picks the workgroup size!
  ivec2 wgBase = ivec2(gl_WorkGroupID.xy) * ivec2(TILE_SIZE_X, TILE_SIZE_Y);

  const uint cmSubgroupId = gl_LocalInvocationIndex / uint(CM_SUBGROUP_SIZE);

  CM_TYPE_C cmAccs[CM_CHANNEL_TILES][CM_PIXEL_TILES_PER_WARP];

  [[unroll]]
  for (uint m = 0; m < CM_CHANNEL_TILES; m++)
  [[unroll]]
  for (uint j = 0; j < CM_PIXEL_TILES_PER_WARP; j++)
  {
    cmAccs[m][j] = CM_TYPE_C(float16_t(0.0));
  }

  for (uint chunk = 0; chunk < uint((IN1_CHANNEL_COUNT + CM_K - 1) / CM_K); chunk++)
  {
    // ---- Load this chunk's input channels into the window ----
    [[unroll]]
    for (uint rr = 0; rr < uint((TILE_SIZE_Y + 2 + WG_SIZE_Y - 1) / WG_SIZE_Y); rr++)
    [[unroll]]
    for (uint cc = 0; cc < uint((CM_WINDOW_ROW_SIZE + WG_SIZE_X - 1) / WG_SIZE_X); cc++)
    {
      uint r = gl_LocalInvocationID.y + rr * WG_SIZE_Y;
      uint c = gl_LocalInvocationID.x + cc * WG_SIZE_X;

      if (r < uint(TILE_SIZE_Y + 2) && c < uint(CM_WINDOW_ROW_SIZE))
      {
        ivec2 coord = wgBase + ivec2(int(c) - 1, int(r) - 1);

        bool oob = any(lessThan(coord, ivec2(0))) ||
                   any(greaterThanEqual(uvec2(coord), uvec2(ubo.imageWidth, ubo.imageHeight)));

        // Zero out of bounds pixels, the tile padding columns as well as the
        // channels past the end of the input.
        bool pad = (c >= uint(TILE_SIZE_X + 2));

        uint base = (r * uint(CM_WINDOW_ROW_SIZE) + c) * uint(CM_K);

        [[unroll]]
        for (uint k = 0; k < CM_K; k++)
        {
          uint ic = chunk * uint(CM_K) + k;

          float16_t value = float16_t(0.0);

          if (!oob && !pad && ic < uint(IN1_CHANNEL_COUNT))
          {
            value = inPixels[(coord.y * ubo.imageWidth + coord.x) * IN1_CHANNEL_COUNT + ic];

#ifdef SCALE_INPUT_INV
            value *= invValueScale;
#endif
          }

          sh_window[base + k] = value;
        }
      }
    }

    barrier();

    for (uint tap = 0; tap < KERNEL_SIZE_SQ; tap++)
    {
      // ---- Stage the weights of all output channels for this tap ----
      const uint aBufferOffset = (tap & 1) * uint(CM_RESULT_CHANNEL_COUNT * CM_K);

      for (uint i = gl_LocalInvocationIndex; i < uint(CM_RESULT_CHANNEL_COUNT * CM_K); i += uint(WG_SIZE_X * WG_SIZE_Y))
      {
        uint m = i / uint(CM_K);
        uint ic = chunk * uint(CM_K) + (i % uint(CM_K));

        float16_t value = float16_t(0.0);

        if (m < uint(CONV_CHANNEL_COUNT) && ic < uint(IN1_CHANNEL_COUNT))
        {
          value = tensors[ubo.weightOffset + (m * uint(IN1_CHANNEL_COUNT) + ic) * uint(KERNEL_SIZE_SQ) + tap]; // OIHW
        }

        sh_weights[aBufferOffset + i] = value;
      }

      barrier();

      // ---- Gather the weight (A) operands ----
      CM_TYPE_A cmWeights[CM_CHANNEL_TILES];

      [[unroll]]
      for (uint m = 0; m < CM_CHANNEL_TILES; m++)
      {
        coopMatLoad(cmWeights[m], sh_weights, aBufferOffset + m * uint(CM_M * CM_K), uint(CM_K), gl_CooperativeMatrixLayoutRowMajor);
      }

      // ---- Multiply-add for each pixel tile owned by this subgroup ----
      [[unroll]]
      for (uint j = 0; j < CM_PIXEL_TILES_PER_WARP; j++)
      {
        const uint pixelTile = cmSubgroupId * uint(CM_PIXEL_TILES_PER_WARP) + j;

        if (pixelTile < uint(CM_PIXEL_TILES))
        {
          const uint tileX = (pixelTile % uint(CM_TILES_PER_ROW)) * uint(CM_N);
          const uint tileY = pixelTile / uint(CM_TILES_PER_ROW);

          // The columns of B are consecutive pixels of a window row.
          uint bElement = ((tileY + tap / uint(KERNEL_SIZE)) * uint(CM_WINDOW_ROW_SIZE) + tileX + (tap % uint(KERNEL_SIZE))) * uint(CM_K);

          CM_TYPE_B cmWindow;
          coopMatLoad(cmWindow, sh_window, bElement, uint(CM_K), gl_CooperativeMatrixLayoutColumnMajor);

          [[unroll]]
          for (uint m = 0; m < CM_CHANNEL_TILES; m++)
          {
            cmAccs[m][j] = coopMatMulAdd(cmWeights[m], cmWindow, cmAccs[m][j]);
          }
        }
      }
    }
  }

  // ---- Store the per-pixel results for the post processing ----
  [[unroll]]
  for (uint m = 0; m < CM_CHANNEL_TILES; m++)
  [[unroll]]
  for (uint j = 0; j < CM_PIXEL_TILES_PER_WARP; j++)
  {
    const uint pixelTile = cmSubgroupId * uint(CM_PIXEL_TILES_PER_WARP) + j;

    if (pixelTile < uint(CM_PIXEL_TILES))
    {
      const uint tileX = (pixelTile % uint(CM_TILES_PER_ROW)) * uint(CM_N);
      const uint tileY = pixelTile / uint(CM_TILES_PER_ROW);

      coopMatStore(cmAccs[m][j], sh_results,
                   (tileY * uint(CM_RESULT_SIZE_X) + tileX) * uint(CM_RESULT_CHANNEL_COUNT) + m * uint(CM_M),
                   uint(CM_RESULT_CHANNEL_COUNT), gl_CooperativeMatrixLayoutColumnMajor);
    }
  }

  // The results are read back by invocations other than the ones that stored them.
  barrier();

#ifdef OP_MAX_POOL
  // Pool the 2x2 convolution result block of this invocation. The results had to
  // be exchanged through shared memory, as their pre-pooling distribution across
  // a subgroup is implementation defined.
  if (gl_GlobalInvocationID.x < ubo.imageWidth / 2 &&
      gl_GlobalInvocationID.y < ubo.imageHeight / 2)
  {
    uint lx = uint(gl_LocalInvocationID.x) * uint(OUT_COLS_PER_THREAD);
    uint ly = uint(gl_LocalInvocationID.y) * uint(OUT_ROWS_PER_THREAD);

    int inIdx = int(gl_GlobalInvocationID.y * (ubo.imageWidth / 2) + gl_GlobalInvocationID.x);

    for (uint oc = 0; oc < CONV_CHANNEL_COUNT; oc++)
    {
      float16_t result = max(max(RESULT_AT(ly, lx, oc), RESULT_AT(ly, lx + 1, oc)),
                             max(RESULT_AT(ly + 1, lx, oc), RESULT_AT(ly + 1, lx + 1, oc)));

      result += tensors[ubo.biasOffset + oc];

      result = max(result, float16_t(0.0)); // ReLU activation

      outPixels[inIdx * OUT_CHANNEL_COUNT + oc] = result;
    }
  }
#endif

#else

#error Unsupported convolution mode.

#endif


#ifndef OP_MAX_POOL

  // For the shader implementations that keep per-invocation results, the shared
  // results are only read back by the invocation that wrote them (pooled layers
  // write their output directly above). The cooperative matrix implementation
  // exchanges them across the workgroup instead, hence the barrier.
  for (uint r = 0; r < OUT_ROWS_PER_THREAD; r++)
  {
    uint outY = gl_GlobalInvocationID.y * OUT_ROWS_PER_THREAD + r;

    if (gl_GlobalInvocationID.x >= ubo.imageWidth || outY >= ubo.imageHeight)
      continue;

#ifdef OP_UPSAMPLE
    uint outIdx0 = uint(gl_GlobalInvocationID.x * 2 + 0 + (outY * 2 + 0) * ubo.imageWidth * 2);
    uint outIdx1 = uint(gl_GlobalInvocationID.x * 2 + 1 + (outY * 2 + 0) * ubo.imageWidth * 2);
    uint outIdx2 = uint(gl_GlobalInvocationID.x * 2 + 0 + (outY * 2 + 1) * ubo.imageWidth * 2);
    uint outIdx3 = uint(gl_GlobalInvocationID.x * 2 + 1 + (outY * 2 + 1) * ubo.imageWidth * 2);
#endif

    int inIdx = int(outY * ubo.imageWidth + gl_GlobalInvocationID.x);

    for (uint oc = 0; oc < CONV_CHANNEL_COUNT; oc++)
    {
      float16_t result = RESULT_AT(gl_LocalInvocationID.y * OUT_ROWS_PER_THREAD + r, gl_LocalInvocationID.x, oc);

      result += tensors[ubo.biasOffset + oc];

      result = max(result, float16_t(0.0)); // ReLU activation

#ifdef SCALE_OUTPUT
      result *= float16_t(valueScale);
#endif

#ifdef OUT_CHANNEL_F32
      float convertedResult = float(result);
#else
      float16_t convertedResult = result;
#endif

#ifdef OP_UPSAMPLE
      outPixels[outIdx0 * OUT_CHANNEL_COUNT + oc] = convertedResult;
      outPixels[outIdx1 * OUT_CHANNEL_COUNT + oc] = convertedResult;
      outPixels[outIdx2 * OUT_CHANNEL_COUNT + oc] = convertedResult;
      outPixels[outIdx3 * OUT_CHANNEL_COUNT + oc] = convertedResult;
#else
      outPixels[inIdx * OUT_CHANNEL_COUNT + oc] = convertedResult;
#endif
    }

#ifdef OP_CONCAT
    for (int i = 0; i < IN2_CHANNEL_COUNT; i++)
    {
#ifndef OP_UPSAMPLE
      float16_t in2Value = inPixels2[inIdx * IN2_CHANNEL_COUNT + i];

#ifdef SCALE_INPUT2_INV
      // As in the reference, only the color channels are normalized, not albedo/normal.
      in2Value *= (i < 3) ? invValueScale : float16_t(1.0);
#endif

      outPixels[inIdx * OUT_CHANNEL_COUNT + CONV_CHANNEL_COUNT + i] = in2Value;
#else
      float16_t in2Value0 = inPixels2[outIdx0 * IN2_CHANNEL_COUNT + i];
      float16_t in2Value1 = inPixels2[outIdx1 * IN2_CHANNEL_COUNT + i];
      float16_t in2Value2 = inPixels2[outIdx2 * IN2_CHANNEL_COUNT + i];
      float16_t in2Value3 = inPixels2[outIdx3 * IN2_CHANNEL_COUNT + i];

#ifdef SCALE_INPUT2_INV
      float16_t in2Scale = (i < 3) ? invValueScale : float16_t(1.0);
      in2Value0 *= in2Scale;
      in2Value1 *= in2Scale;
      in2Value2 *= in2Scale;
      in2Value3 *= in2Scale;
#endif

      outPixels[outIdx0 * OUT_CHANNEL_COUNT + CONV_CHANNEL_COUNT + i] = in2Value0;
      outPixels[outIdx1 * OUT_CHANNEL_COUNT + CONV_CHANNEL_COUNT + i] = in2Value1;
      outPixels[outIdx2 * OUT_CHANNEL_COUNT + CONV_CHANNEL_COUNT + i] = in2Value2;
      outPixels[outIdx3 * OUT_CHANNEL_COUNT + CONV_CHANNEL_COUNT + i] = in2Value3;
#endif
    }
#endif
  }

#endif

}
